    if li_snapshot.quote_stale:
        st.write("Quote status: **Stale** (no live data)")
    if li_snapshot.bar_stale:
        st.write("Bar status: **Stale** (no live data)")

    st.divider()

    # --- Time navigation controls ---
    st.subheader("Time navigation")
    # Date + time picker for chart start
    default_start_kigali = "2026-07-20 00:00"  # earliest minute data
    chart_start_kigali = st.text_input(
        "Chart start (Kigali time)",
        value=default_start_kigali,
        help="Select the exact start time for the visible chart window. "
             "Convert to UTC internally for data filtering.",
    )
    chart_start_utc = kigali_to_utc(chart_start_kigali)

    # Quick range presets
    quick_range = st.selectbox(
        "Quick range",
        ["Custom", "Today", "1 hour", "2 hours", "4 hours", "12 hours", "24 hours", "7 days"],
        index=0,
    )
    # Apply quick range offset to chart_start_utc
    if quick_range != "Custom":
        now_utc = pd.Timestamp.utcnow()
        if quick_range == "Today":
            chart_start_utc = now_utc.normalize()
        elif quick_range == "1 hour":
            chart_start_utc = now_utc - pd.Timedelta(hours=1)
        elif quick_range == "2 hours":
            chart_start_utc = now_utc - pd.Timedelta(hours=2)
        elif quick_range == "4 hours":
            chart_start_utc = now_utc - pd.Timedelta(hours=4)
        elif quick_range == "12 hours":
            chart_start_utc = now_utc - pd.Timedelta(hours=12)
        elif quick_range == "24 hours":
            chart_start_utc = now_utc - pd.Timedelta(days=1)
        elif quick_range == "7 days":
            chart_start_utc = now_utc - pd.Timedelta(days=7)
        # Re-convert from UTC back to Kigali for display
        chart_start_kigali = utc_to_kigali(chart_start_utc)

    st.divider()

    # Lookback window (how far back from chart_start the chart shows)
    st.subheader("Lookback window (bars)")
    lookback_bars = st.slider(
        "Number of bars from chart_start",
        min_value=10,
        max_value=5000,
        value=min(1000, len(pd.read_csv(MINUTE_PATH, sep=None, engine="python", header=None, names=["time","open","high","low","close","volume"], parse_dates=["time"]))),
    )

    # Forecast horizon
    st.subheader("Forecast horizon")
    forecast_horizon_minutes = st.selectbox(
        "Forecast ahead",
        ["None", "30 minutes", "1 hour", "2 hours", "4 hours"],
        index=0,
    )
    forecast_horizon_min = 0 if forecast_horizon_minutes == "None" else int(forecast_horizon_minutes.split()[0])
    forecast_horizon_utc = pd.Timedelta(minutes=forecast_horizon_min)

    st.divider()

    st.subheader("Backtest settings")
    strategy_name = st.selectbox("Strategy", list_strategies(), index=0)
    signal_fn, default_params = get_strategy(strategy_name)
    desc = BASELINE_STRATEGIES[strategy_name][2]
    st.caption(f"*{desc}*")

    # Strategy-specific parameter inputs
    params: dict[str, Any] = dict(default_params)
    if strategy_name == "sma_crossover":
        c1, c2 = st.columns(2)
        params["fast_window"] = c1.number_input(
            "Fast SMA", min_value=2, max_value=100, value=int(params.get("fast_window", 20))
        )
        slow_default = max(int(params.get("slow_window", 50)), int(params["fast_window"]) + 1)
        params["slow_window"] = c2.number_input(
            "Slow SMA",
            min_value=int(params["fast_window"]) + 1,
            max_value=250,
            value=slow_default,
        )
    elif strategy_name == "rsi_mean_reversion":
        params["rsi_window"] = st.number_input(
            "RSI window", min_value=2, max_value=50, value=int(params.get("rsi_window", 14))
        )
        params["oversold"] = st.number_input(
            "Oversold threshold", min_value=1.0, max_value=49.0, value=float(params.get("oversold", 30.0)), step=1.0
        )
        params["overbought"] = st.number_input(
            "Overbought threshold", min_value=51.0, max_value=99.0, value=float(params.get("overbought", 70.0)), step=1.0
        )
    elif strategy_name == "momentum":
        params["lookback"] = st.number_input(
            "Lookback (bars)", min_value=2, max_value=500, value=int(params.get("lookback", 20))
        )

    st.divider()
    cost_bps = st.number_input(
        "Cost per position change (bps)", min_value=0.0, max_value=100.0, value=0.2, step=0.1
    )
    train_frac = st.number_input(
        "Train fraction", min_value=0.1, max_value=0.8, value=0.6, step=0.1
    )
    val_frac = st.number_input(
        "Validation fraction", min_value=0.1, max_value=0.5, value=0.2, step=0.05
    )
    test_frac = 1.0 - train_frac - val_frac
    st.caption(f"Test fraction: {test_frac:.2f}")
    st.divider()

    st.error(
        "HISTORICAL DATA ONLY — not a live quote. "
        "Source timezone is not verified. Never treat the last close as a live price."
    )

