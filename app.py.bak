# ---------------------------------------------------------------------------
# Helpers: timezone conversion (Africa/Kigali = UTC+3 no DST)
# ---------------------------------------------------------------------------
KIGALI_TZ_OFFSET = 3  # hours, no DST

def kigali_to_utc(dt_str: str) -> pd.Timestamp:
    """Parse a naive Kigali-local datetime string and convert to UTC."""
    try:
        dt = pd.to_datetime(dt_str, utc=False)
        if dt.tz is None:
            # Assume Kigali local (UTC+3)
            dt = dt + pd.Timedelta(hours=KIGALI_TZ_OFFSET)
        return dt.tz_localize("UTC")
    except Exception:
        return pd.NaT

def utc_to_kigali(utc_ts: pd.Timestamp) -> str:
    """Convert a UTC timestamp to Kigali-local string for display."""
    if pd.isna(utc_ts):
        return "—"
    kigali = utc_ts.tz_convert("Africa/Kigali")
    return kigali.strftime("%Y-%m-%d %H:%M")

