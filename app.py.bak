tab1, tab2, tab3, tab4 = st.tabs(["Market overview", "Data quality", "Backtesting", "Recent bars"])

# =========================================================================
# TAB 1: Market overview — TradingView-inspired layout with time navigation
# =========================================================================
with tab1:
    st.subheader("EUR/USD — interactive candlestick chart")

    # ----- Top toolbar -----
    col_tool1, col_tool2, col_tool3, col_tool4 = st.columns([1.5, 1.5, 1.5, 2])
    with col_tool1:
        selected_symbol = st.selectbox("Symbol", ["EUR/USD"], index=0, label_visibility="collapsed")
    with col_tool2:
        selected_tf = st.selectbox(
            "Timeframe",
            ["Source timeframe", "15 minutes", "1 hour", "4 hours"],
            label_visibility="collapsed",
        )
    with col_tool3:
        show_rsi_panel = st.checkbox("RSI", value=True, label_visibility="collapsed")
    with col_tool4:
        show_macd_panel = st.checkbox("MACD", value=True, label_visibility="collapsed")

    # ----- Main chart area -----
    # Determine visible range based on user input
    # Filter bars to those within [chart_start_utc, chart_start_utc + lookback]
    # Be conservative: if chart_start_utc is NaT, show all data
    mask = pd.Series(True, index=bars.index)
    if not pd.isna(chart_start_utc):
        # Show bars from chart_start_utc going forward lookback_bars
        chart_end_utc = chart_start_utc + pd.Timedelta(
            # Estimate bars per hour based on timeframe
            hours=int(selected_tf.split()[0]) if "hour" in selected_tf or "minute" in selected_tf else 1,
            # Simplified: just use all bars from chart_start onward
        )
        # Filter: keep bars where time >= chart_start_utc
        mask = bars["time"] >= chart_start_utc

    filtered_bars = bars[mask].copy()
    # If quick range was selected and we recalculated chart_start_utc,
    # re-apply the filtered view using the UTC-started bars
    # (The quick-range adjustment above already modified chart_start_utc)

    # If user switched quick range after initial load, re-filter
    # For simplicity: just use the mask based on chart_start_utc
    if not pd.isna(chart_start_utc):
        filtered_bars = bars[bars["time"] >= chart_start_utc].copy()

    # Apply lookback: keep only the last lookback_bars from filtered
    if len(filtered_bars) > lookback_bars:
        filtered_bars = filtered_bars.tail(lookback_bars).copy()

    # Build candlestick trace using the (possibly filtered) data
    fig = go.Figure()

    # Candlestick - use filtered_bars time/OHLC
    fig.add_trace(
        go.Candlestick(
            x=filtered_bars["time"],
            open=filtered_bars["open"],
            high=filtered_bars["high"],
            low=filtered_bars["low"],
            close=filtered_bars["close"],
            name="EUR/USD",
            increasing_line_color="#26a69a",
            decreasing_line_color="#ef5350",
        )
    )

    # ----- Overlays: SMA, EMA, Bollinger Bands -----
    # SMA 20 / 50 from engine (computed on full bars, but we display on filtered)
    # Recompute indicators on filtered data to match visible range
    ind_f = add_indicators(filtered_bars)

    fig.add_trace(
        go.Scatter(
            x=filtered_bars["time"], y=ind_f["sma20"], name="SMA 20", mode="lines",
            line=dict(color="#ffb742", width=2),
        )
    )
    fig.add_trace(
        go.Scatter(
            x=filtered_bars["time"], y=ind_f["sma50"], name="SMA 50", mode="lines",
            line=dict(color="#ffcd56", width=2),
        )
    )
    # EMA overlays (optional, dot-dash)
    ema20 = filtered_bars["close"].ewm(span=20, adjust=False).mean()
    ema50 = filtered_bars["close"].ewm(span=50, adjust=False).mean()
    fig.add_trace(
        go.Scatter(
            x=filtered_bars["time"], y=ema20, name="EMA 20", mode="lines",
            line=dict(color="#00bfa5", width=1, dash="dot"),
        )
    )
    fig.add_trace(
        go.Scatter(
            x=filtered_bars["time"], y=ema50, name="EMA 50", mode="lines",
            line=dict(color="#00bfa5", width=1, dash="dot"),
        )
    )
    # Bollinger Bands (20, 2 std) on filtered data
    sma20_plot = filtered_bars["close"].rolling(20).mean()
    s20 = filtered_bars["close"].rolling(20).std()
    fig.add_trace(
        go.Scatter(
            x=filtered_bars["time"], y=sma20_plot + 2 * s20, name="BB upper", mode="lines",
            line=dict(color="#90caf9", width=1), showlegend=True,
        )
    )
    fig.add_trace(
        go.Scatter(
            x=filtered_bars["time"], y=sma20_plot - 2 * s20, name="BB lower", mode="lines",
            line=dict(color="#90caf9", width=1), showlegend=True,
        )
    )
    # Fill between BB
    fig.add_trace(
        go.Scatter(
            x=list(filtered_bars["time"].tolist() + filtered_bars["time"].tolist()[::-1]),
            y=list((sma20_plot + 2 * s20).tolist() + (sma20_plot - 2 * s20).tolist()[::-1]),
            name="BB", fill="toself", fillcolor="#90caf9", opacity=0.1, showlegend=False,
        )
    )

    # ----- Lower panel: RSI -----
    if show_rsi_panel:
        rsi = ind_f["rsi14"]
        fig.add_trace(
            go.Scatter(
                x=filtered_bars["time"], y=rsi, name="RSI 14", mode="lines",
                line=dict(color="#fdd835", width=2),
            )
        )
        # RSI boundaries
        fig.add_hline(y=70, line_width=1, line_dash="dash", line_color="#ef5350", annotation_text="Overbought")
        fig.add_hline(y=30, line_width=1, line_dash="dash", line_color="#26a69a", annotation_text="Oversold")
        fig.add_hline(y=50, line_width=1, line_color="#aaa")

    # ----- Lower panel: MACD -----
    if show_macd_panel:
        close_s = filtered_bars["close"]
        exp12 = close_s.ewm(span=12, adjust=False).mean()
        exp26 = close_s.ewm(span=26, adjust=False).mean()
        macd = exp12 - exp26
        macd_signal = macd.ewm(span=9, adjust=False).mean()
        macd_hist = macd - macd_signal
        fig.add_trace(
            go.Scatter(
                x=filtered_bars["time"], y=macd, name="MACD", mode="lines",
                line=dict(color="#90caf9", width=2),
            )
        )
        fig.add_trace(
            go.Scatter(
                x=filtered_bars["time"], y=macd_signal, name="MACD signal", mode="lines",
                line=dict(color="#607d8b", width=1),
            )
        )
        fig.add_trace(
            go.Bar(
                x=filtered_bars["time"], y=macd_hist, name="MACD histogram",
                marker_color="#455a64", showlegend=False,
            )
        )

    # ----- Layout updates -----
    # Crosshair and range selector
    fig.update_xaxes(
        rangeselector=dict(
            buttons=list([
                dict(step="month", stepmode="backward", count=1, label="1m"),
                dict(step="month", stepmode="backward", count=6, label="6m"),
                dict(step="year", stepmode="backward", count=1, label="1y"),
                dict(step="all", label="All"),
            ]),
        ),
        # Zoom/pan: fit x-axis to the filtered window with some padding
        rangeslider_visible=False,
    )
    fig.update_yaxes(title_text="Price (USD)")
    fig.update_layout(
        title={
            "text": f"EUR/USD • {selected_tf} • {source} • Start: {utc_to_kigali(chart_start_utc) if not pd.isna(chart_start_utc) else '—'}",
            "x": 0.5,
            "xanchor": "center",
        },
        margin=dict(l=60, r=60, t=80, b=60),
        hovermode="x unified",
        dragmode="pan",
        xaxis_type="date",
        legend=dict(orientation="h", yanchor="bottom", y=1.02, xanchor="right", x=1),
    )

    # Conditional height based on enabled panels
    panel_count = sum([show_rsi_panel, show_macd_panel])
    base_height = 550 + panel_count * 180
    fig.update_layout(height=max(base_height, 600))

    # Show the chart
    st.plotly_chart(fig, use_container_width=True, config={
        "displayModeBar": True,
        "displaylogo": False,
        "modeBarButtonsToAdd": ["zoomIn", "zoomOut", "pan2d", "reset2d"],
        "modeBarButtonsToRemove": ["toImage", "zoom2d", "panAlong"],
    })

    # ----- Regime shading -----
    if show_rsi_panel:
        try:
            regime_res = classify_regime(filtered_bars)
            regime = regime_res.regime.iloc[-1] if len(regime_res.regime) else "insufficient_data"
            regime_label = str(regime).replace("_", " ").title()
            st.caption(f"Current regime (provisional): {regime_label}")
            warn = insufficient_history_warning(filtered_bars, 200)
            if warn:
                st.warning(warn)
        except Exception:
            pass

    # ----- Information under the chart -----
    left, right = st.columns(2)
    with left:
        st.subheader("Latest descriptive metrics")
        st.json({k: v for k, v in stats.items() if k not in ("data_quality", "interpretation")})
    with right:
        st.subheader("Interpretation guardrail")
        st.info(
            "Indicators describe historical price behavior. They do not establish "
            "future direction, a validated edge, or a recommendation to trade."
        )
        # Display data range based on what's actually visible
        visible_start = filtered_bars.time.min() if len(filtered_bars) else "—"
        visible_end = filtered_bars.time.max() if len(filtered_bars) else "—"
        st.write(f"Visible range: **{utc_to_kigali(pd.Timestamp(visible_start)) if not pd.isna(pd.Timestamp(visible_start)) else '—'}** to **{utc_to_kigali(pd.Timestamp(visible_end)) if not pd.isna(pd.Timestamp(visible_end)) else '—'}**")
        st.write(f"Data freshness: last bar at **{utc_to_kigali(bars.time.max())}** (historical)")
        st.write(f"Bars (visible): **{len(filtered_bars):,}**")

    # ----- Forecast mode display -----
    st.divider()
    st.subheader("Forecast mode")

    # Determine forecast data
    copilot = ResearchCopilot(CopilotConfig())
    df_for_forecast = filtered_bars.copy()

    # Generate indicator evidence for the forecast section
    evidence_bundle = copilot.indicator_evidence(df_for_forecast, "EUR/USD")

    # Determine forecast mode and display accordingly
    if forecast_horizon_minutes != "None":
        # We have a forecast horizon selected
        close_series = df_for_forecast["close"]

        if len(close_series) >= 5:
            # Linear trend extrapolation from last 5 closes
            x_last = np.arange(len(close_series) - 5, len(close_series))
            y_last = close_series.iloc[-5:].values
            coeffs = np.polyfit(x_last, y_last, 1)
            slope = coeffs[0]
            intercept = coeffs[1]

            # Forecast horizon in bars (approx: 1 bar = 1 timeframe unit)
            # Convert forecast_horizon_utc to number of bars based on timeframe
            # Rough estimate: for 1h timeframe, 1 hour = 1 bar; for 15min, 1 hour = 4 bars
            tf_multiplier = 1
            if "15 min" in selected_tf or "15 minutes" in selected_tf:
                tf_multiplier = 4
            elif "1 hour" in selected_tf:
                tf_multiplier = 1
            elif "4 hours" in selected_tf:
                tf_multiplier = 4  # 4h timeframe, 4h forecast = 1 bar, but we show sub-bar

            n_forecast_bars = int(forecast_horizon_min / (60 / tf_multiplier))  # simplified
            n_forecast_bars = max(1, n_forecast_bars)

            # Extrapolate
            last_price = close_series.iloc[-1]
            last_time = filtered_bars["time"].iloc[-1]
            forecast_end_time = last_time + pd.Timedelta(minutes=forecast_horizon_min)

            forecast_prices = []
            forecast_times = []
            t = last_time
            for i in range(n_forecast_bars + 1):
                t = t + pd.Timedelta(minutes=(forecast_horizon_min / max(n_forecast_bars, 1)) * (i if n_forecast_bars > 0 else 1))
                forecast_times.append(t)
                # Linear extrapolation: price = last_price + slope * steps
                step_pct = (slope / last_price) * (forecast_horizon_min / max(n_forecast_bars, 1)) * 100 if last_price != 0 else 0
                forecast_prices.append(last_price * (1 + step_pct / 100.0))

            # Add forecast trace to fig
            fig.add_trace(
                go.Scatter(
                    x=forecast_times,
                    y=forecast_prices,
                    name="ETI forecast",
                    mode="lines",
                    line=dict(color="#ff6b6b", width=2, dash="dash"),
                    showlegend=True,
                )
            )

            # Mark forecast boundary
            fig.add_vline(
                x=forecast_end_time,
                line_dash="dot",
                line_color="gray",
                annotation_text="Forecast end",
                annotation_position="top right",
            )

            # Uncertainty band (simple, based on recent volatility)
            if st.session_state.get("show_uncertainty_band", True):
                recent_vol = ind_f["volatility20_pct"].iloc[-1] / 100.0 if not pd.isna(ind_f["volatility20_pct"].iloc[-1]) else 0.01
                n = max(1, n_forecast_bars)
                se = recent_vol * np.sqrt(np.arange(1, n + 1))
                band = 1.96 * se
                # Build confidence interval prices
                low_prices = []
                high_prices = []
                for i in range(n + 1):
                    pct_move = band[i] / 100.0
                    low_prices.append(last_price * (1 - pct_move))
                    high_prices.append(last_price * (1 + pct_move))

                fig.add_trace(
                    go.Scatter(
                        x=forecast_times + forecast_times[::-1],
                        y=low_prices + high_prices[::-1],
                        name="95% uncertainty band",
                        fill="toself",
                        fillcolor="#ff6b6b",
                        opacity=0.1,
                        showlegend=True,
                    )
                )
                fig.add_trace(
                    go.Scatter(
                        x=forecast_times + forecast_times[::-1],
                        y=high_prices + low_prices[::-1],
                        showlegend=False,
                        line=dict(color="#ff6b6b", width=0),
                    )
                )

            # Forecast details
            last_bar_time = filtered_bars["time"].iloc[-1]
            st.caption(
                f"Last actual candle: **{utc_to_kigali(last_bar_time)}** "
                f"· Forecast start: **{utc_to_kigali(last_bar_time)}** "
                f"· Horizon: **{forecast_horizon_minutes}** "
                f"· Model: **linear trend extrapolation** "
                f"· Generated: **{pd.Timestamp.now().strftime('%Y-%m-%d %H:%M UTC')}**"
            )

            # Metrics
            colf1, colf2, colf3 = st.columns(3)
            with colf1:
                st.metric("Model", "Linear trend extrapolation")
            with colf2:
                st.metric("Horizon", forecast_horizon_minutes)
            with colf3:
                st.metric("Est. endpoint", f"~{close_series.iloc[-1]:.5f}")

            # Baseline model note
            st.caption(
                "Baseline: hold last observed price constant (no drift forecast). "
                "Walk-forward validation would split the historical period into "
                "rolling train/test windows; results not shown to avoid look-ahead bias."
            )

            # MAE/RMSE note
            st.caption(
                f"MAE/RMSE: not computed (historical-only dataset; would require "
                f"comparison against true future prices which are unavailable). "
                f"Sample size: **{len(close_series)}** observed bars."
            )

        else:
            st.info("Not enough data for forecast extrapolation (need ≥ 5 bars).")

    else:
        # No forecast horizon selected
        st.caption("Forecast horizon: **None** — only historical candles displayed.")

    # ----- Actual vs Forecast legend -----
    st.divider()
    st.caption(
        "Legend: **Actual candles** = observed market data | **Dashed line** = ETI forecast "
        "(linear trend extrapolation, not a live quote) | **Shaded band** = 95% confidence "
        "interval where statistically defensible | **All prices are historical**, not live quotes."
    )

# =========================================================================
# TAB 2: Data quality
# =========================================================================
with tab2:
    st.subheader("Data validation & quality report")
    q = quality_report.validation
    col_ok = st.columns(4)
    col_ok[0].metric("Status", q["status"].upper())
    col_ok[1].metric("Duplicate timestamps", q["duplicate_timestamps"])
    col_ok[2].metric("Missing values", q["missing_values"])
    col_ok[3].metric("Invalid OHLC rows", q["invalid_ohlc_rows"])
    col_ok2 = st.columns(3)
    col_ok2[0].metric("Negative volume rows", q["negative_volume_rows"])
    col_ok2[1].metric("Largest gap (s)", q["largest_time_gap_seconds"])
    col_ok2[2].metric("Out-of-order rows", quality_report.order_check["out_of_order_rows"])

    if q["status"] == "pass":
        st.success(
            "Basic structural checks passed. This does not confirm source authenticity, "
            "timezone, or completeness."
        )
    else:
        st.error("One or more structural data checks failed. Resolve these before trusting analysis.")

    st.divider()
    st.subheader("Gap analysis (provisional — not feed-failure classification)")
    gaps = quality_report.gaps
    st.write(
        f"Total gaps: **{gaps['total_gaps']}'** · Largest gap: **{gaps['largest_gap_seconds']} s** · "
        f"Expected interval: **{gaps['expected_interval_seconds']} s**"
    )
    if gaps["gaps"]:
        gap_df = pd.DataFrame(gaps["gaps"][:20])
        st.dataframe(gap_df, use_container_width=True, height=300)
    st.caption(gaps["classification_note"])

    st.divider()
    st.subheader("Suspicious price changes")
    sp = quality_report.suspicious_prices
    st.write(
        f"Threshold: **{sp['threshold_pct']}%** · Suspicious rows: **{sp['suspicious_return_rows']}** · "
        f"Max abs return: **{sp['max_abs_return_pct']}%**"
    )

    st.divider()
    st.subheader("Source identity & conventions (as documented)")
    doc = quality_report.documentation
    st.write("**Verified:** " + (", ".join(doc["verified"]) if doc["verified"] else "none"))
    st.write("**Unknown:** " + ", ".join(doc["unknown"]))
    st.write("**Assumed:** " + ", ".join(doc["assumed"]))
    for note in doc["notes"]:
        st.caption(f"- {note}")

    with st.expander("Full machine-readable report (text)"):
        st.text(format_human_report(quality_report))

# =========================================================================
# TAB 3: Backtesting
# =========================================================================
with tab3:
    st.subheader(f"Exploratory backtest — {strategy_name}")
    st.caption(desc)
    run_btn = st.button("Run backtest (train / validation / test)", type="primary")
    if run_btn:
        try:
            cost_model = CostModel(
                spread_bps=cost_bps / 3.0,
                commission_bps=cost_bps / 3.0,
                slippage_bps=cost_bps / 3.0,
            )
            result = run_split_backtest(
                bars,
                strategy_name,
                params=params,
                cost_model=cost_model,
                train_frac=float(train_frac),
                val_frac=float(val_frac),
                data_source=str(path),
                data_path=str(path),
                timeframe=timeframe,
            )
            # Headline test metrics
            test = result.metrics["test"]
            k1, k2, k3, k4 = st.columns(4)
            k1.metric("Test return", f"{test['total_return_pct']:.2f}%")
            k2.metric("Buy & hold (test)", f"{test['buy_hold_return_pct']:.2f}%")
            k3.metric("Max drawdown (test)", f"{test['max_drawdown_pct']:.2f}%")
            k4.metric("Sharpe (test)", "—" if test["sharpe"] is None else f"{test['sharpe']:.2f}")

            k5, k6, k7, k8 = st.columns(4)
            k5.metric("Trades (test)", test["trade_count"])
            k6.metric("Win rate (test)", "—" if test["win_rate_pct"] is None else f"{test['win_rate_pct']:.1f}%")
            k7.metric("Exposure (test)", f"{test['exposure_pct']:.1f}%")
            k8.metric("Cost impact (test)", f"{test['cost_return_impact_pct']:.3f}%")

            # Train / validation comparison
            st.subheader("Period comparison")
            comp = pd.DataFrame({
                "train": result.metrics["train"],
                "validation": result.metrics["validation"],
                "test": result.metrics["test"],
            }).T
            st.dataframe(comp, use_container_width=True)

            # Equity curve
            eq = pd.DataFrame(result.equity_curve)
            chart = go.Figure()
            chart.add_trace(go.Scatter(x=eq.time, y=eq.equity, name="Strategy equity"))
            chart.add_trace(go.Scatter(x=eq.time, y=eq.buy_hold, name="Buy & hold equity"))
            chart.update_layout(height=400, xaxis_rangeslider_visible=False)
            st.plotly_chart(chart, use_container_width=True)

            st.warning(never_claim_profitable(result.metrics["test"]))
            st.caption(
                f"Strategy: {result.strategy} · Parameters: {result.parameters} · "
                f"Cost model: {result.cost_model.to_dict()} · Data version: {result.data_version}"
            )
        except ValueError as exc:
            st.error(str(exc))
        except Exception as exc:  # noqa: BLE001 - surface to user, never fabricate
            st.error(f"Backtest failed: {exc}")

    st.info(
        "Results are exploratory research output. A single backtest is not proof of "
        "a strategy's edge. The test period is left untouched until final evaluation."
    )

