@st.cache_data(show_spinner=False)
def _load(path_str: str):
    return load_bars(path_str)

# Load data (cached)
# ---------------------------------------------------------------------------
# Determine the active provider and load bars accordingly.
active_provider_name = default_registry.active_name()
provider = default_registry.active()

if active_provider_name == "twelve_data":
    # Try to get latest bars from Twelve Data.
    # We use "1min" as the intraday timeframe; the user can select a
    # different timeframe later in the UI, but we need at least one bar
    # to establish the data start point.
    twelve_bars = provider.get_bars(
        "EUR/USD",
        "1min",
        start=pd.Timestamp("2020-01-01", tz="UTC"),
        end=pd.Timestamp.utcnow(),
    )
    if twelve_bars:
        # Twelve Data returns bars newest-first; reverse to chronological.
        twelve_bars_reversed = list(reversed(twelve_bars))
        # Build a DataFrame from the Twelve Data bars.
        twelve_df = pd.DataFrame({
            "time": [b.timestamp for b in twelve_bars_reversed],
            "open": [b.open for b in twelve_bars_reversed],
            "high": [b.high for b in twelve_bars_reversed],
            "low": [b.low for b in twelve_bars_reversed],
            "close": [b.close for b in twelve_bars_reversed],
            "volume": [b.volume for b in twelve_bars_reversed],
        })
        # Ensure timezone-naive UTC timestamps for consistency with CSV data.
        twelve_df["time"] = pd.to_datetime(twelve_df["time"], utc=True).tz_localize(None)
        raw = twelve_df
    else:
        # Fall back to CSV if Twelve Data returns no bars.
        path = DAILY_PATH if source.startswith("Daily") else MINUTE_PATH
        if not path.exists():
            st.error(f"Dataset not found: {path}. Place the source CSV in data/raw.")
            st.stop()
        raw = _load(str(path))
else:
    # Default: load from historical CSV.
    path = DAILY_PATH if source.startswith("Daily") else MINUTE_PATH
    if not path.exists():
        st.error(f"Dataset not found: {path}. Place the source CSV in data/raw.")
        st.stop()
    raw = _load(str(path))



@st.cache_data(show_spinner=False)
def _indicators(df: pd.DataFrame):
    return add_indicators(df)


@st.cache_data(show_spinner=False)
def _quality(df: pd.DataFrame, path_str: str):
    return build_data_quality_report(path_str, df)



raw = _load(str(path))
